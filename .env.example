# ==============================================================================
# Docker Compose & Project Configuration
# ==============================================================================
COMPOSE_PROJECT_NAME=kms_service
APP_ENVIRONMENT=development
DOCKER_RESTART_POLICY=unless-stopped

# ==============================================================================
# KMS Crypto & Envelope Encryption Settings
# ==============================================================================
# Master Key dla AES-256-GCM (wymagane dokładnie 32 bajty po zdekodowaniu z Base64)
# Wygenerowano przykładowy klucz 256-bitowy:
CRYPTO__MASTER_KEY_B64=dWRGdk1pZ0lqNmIzeXo4bEF1SEpvaU5qTndqRWxYOWU=
CRYPTO__DEFAULT_KEY_TTL_DAYS=365

# ==============================================================================
# HTTP Server Configuration
# ==============================================================================
SERVER__HOST=0.0.0.0
SERVER__PORT=8080
SERVER__SHUTDOWN_TIMEOUT=15

# ==============================================================================
# Database Credentials (MongoDB)
# ==============================================================================
DATABASE__HOST=127.0.0.1
DATABASE__PORT=27017
DATABASE__NAME=kms_db
DATABASE__USER=kms_app_user
DATABASE__PASSWORD=your_secure_app_password
DATABASE__POOL_SIZE=10
DATABASE__AUTH_SOURCE=admin

# Root Credentials (MongoDB container init)
MONGO_ROOT_USER=admin_user
MONGO_ROOT_PASSWORD=your_secure_root_password

# ==============================================================================
# Cache & Public Keys Store (Redis)
# ==============================================================================
REDIS__HOST=127.0.0.1
REDIS__PORT=6379
REDIS__PASSWORD=your_secure_redis_password
REDIS__DB=0

# ==============================================================================
# Rate Limiting Settings
# ==============================================================================
RATE_LIMIT__GLOBAL_PER_SECOND=100
RATE_LIMIT__GLOBAL_BURST=200
RATE_LIMIT__HEALTH_PER_SECOND=10
RATE_LIMIT__HEALTH_BURST=20
RATE_LIMIT__AUTH_PER_SECOND=5
RATE_LIMIT__AUTH_BURST=10