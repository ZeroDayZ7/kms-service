{
  // === Explorer & Search ===
  "files.exclude": {
    "**/target": true,
    "**/Cargo.lock": true,
    "**/.git": true,
    // "**/.vscode": true,
    // "**/tests": true,
    "LICENSE": true,
    "logs": true
    // ".env.example": true
    // "README.md": true
    // "**/.env": true
  },
  "search.exclude": {
    "**/target": true,
    "**/Cargo.lock": true,
    "**/.git": true,
    "**/.vscode": true,
    "**/tests": true,
    "LICENSE": true,
    "logs": true,
    ".env.example": true,
    "README.md": true,
    "**/combined.txt": true
  },

  // === Rust / Cargo ===
  "rust-analyzer.cargo.loadOutDirsFromCheck": true,
  "rust-analyzer.procMacro.enable": true,

  // === Formatowanie ===
  "editor.formatOnSave": true,
  // "[rust]": {
  //     "editor.defaultFormatter": "rust-lang.rust-analyzer"
  // },

  // === Terminal ===
  "terminal.integrated.shell.windows": "powershell.exe"
}
